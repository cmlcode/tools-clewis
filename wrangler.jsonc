{
  "name": "tools-clewis",
  "compatibility_date": "2026-07-01",
  "main": "src/worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
			"/auth/*",
			"/api/*"
		]
  },
  "d1_databases": [
    {
      "binding": "BAR_DB",
      "database_name": "tools-clewis-bar",
      "database_id": "84808e7c-d293-49c6-b3ef-91bf0e949e77"
    }
  ]
}
